# Aplicacao
NODE_ENV=development
PORT=3000

# Banco de dados PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=oficina
DB_PASSWORD=oficina
DB_DATABASE=oficina
# Em ambiente de desenvolvimento o schema e sincronizado automaticamente.
# Em producao utilize migrations e mantenha este valor como false.
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Autenticacao JWT
JWT_SECRET=troque-por-um-segredo-forte-em-producao
JWT_EXPIRES_IN=3600s

# Usuario administrador criado pelo seed
ADMIN_EMAIL=admin@oficina.com.br
ADMIN_PASSWORD=Admin@123
