# Aplicacao
NODE_ENV=development
PORT=3000

# Banco de dados PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=oficina
DB_PASSWORD=oficina
DB_DATABASE=oficina
# O schema e criado pelas migrations (src/database/migrations), aplicadas na
# subida da aplicacao. Mantenha a sincronizacao automatica desligada.
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=true
DB_LOGGING=false

# Autenticacao JWT
JWT_SECRET=troque-por-um-segredo-forte-em-producao
JWT_EXPIRES_IN=3600s

# Usuario administrador criado pelo seed
ADMIN_EMAIL=admin@oficina.com.br
ADMIN_PASSWORD=Admin@123
